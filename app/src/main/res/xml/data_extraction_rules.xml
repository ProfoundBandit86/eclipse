<?xml version="1.0" encoding="utf-8"?>
<!-- Eclipse keeps passwords and API keys (RomM, library share, IGDB, SteamGridDB, RetroAchievements) in its
     own storage: none of it goes into cloud backups or phone-to-phone transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
